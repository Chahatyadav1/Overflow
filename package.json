{
  "name": "orderflow-api",
  "version": "1.0.0",
  "description": "OrderFlow API - A robust order management system with authentication, built for CI/CD pipelines",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "NODE_ENV=test jest --coverage --runInBand",
    "test:unit": "NODE_ENV=test jest --testPathPattern=unit --coverage",
    "test:integration": "NODE_ENV=test jest --testPathPattern=integration --runInBand --coverage",
    "lint": "eslint src/",
    "sonar": "sonar-scanner",
    "audit-fix": "npm audit fix"
  },
  "keywords": ["order", "management", "api", "jenkins", "sonarqube", "docker"],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "mongoose-paginate-v2": "^1.8.6",
    "mongoose-delete": "^1.0.2",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "eslint": "^9.18.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.31.0",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.1.3",
    "nodemon": "^3.1.9",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": ["<rootDir>/tests/setEnvVars.js"],
    "setupFilesAfterEnv": ["<rootDir>/tests/setup.js"],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/src/server.js",
      "/tests/",
      "/src/config/",
      "/src/utils/logger.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 90,
        "functions": 90,
        "lines": 90,
        "statements": 90
      }
    }
  }
}